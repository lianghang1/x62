# 复制为 .env 后按需修改；所有密钥/账密一律走环境变量，严禁硬编码进代码或配置文件

# ---- 数据库（批次②启用）----
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/scaffold?useUnicode=true&characterEncoding=utf8&serverTimezone=GMT%2B8
# SPRING_DATASOURCE_USERNAME=scaffold
# SPRING_DATASOURCE_PASSWORD=change-me

# ---- Redis（批次③启用）----
# SPRING_REDIS_HOST=127.0.0.1
# SPRING_REDIS_PORT=6379
# SPRING_REDIS_PASSWORD=change-me

# ---- 敏感字段加密（starter-crypto）----
# AES（默认）或 SM4（国密/信创）；key 为派生密钥口令，长度随意但必须足够随机
# SCAFFOLD_CRYPTO_TYPE=AES
# SCAFFOLD_CRYPTO_KEY=change-me-32-bytes-random-secret

# ---- PowerJob 调度中心（接入时启用，见 README）----
# POWERJOB_SERVER=127.0.0.1:7700
# POWERJOB_ACCESS_TOKEN=change-me

# ---- 服务 ----
SERVER_PORT=8080
