<?xml version="1.0" encoding="UTF-8"?>
<!-- 任务执行日志（starter-job）+ 示例订单（demo，VersionedEntity 乐观锁） -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="v1.0.0-job-run-log" author="scaffold">
        <createTable tableName="job_run_log">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_job_run_log"/>
            </column>
            <column name="job_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIMESTAMP"/>
            <column name="cost_millis" type="BIGINT"/>
            <column name="status" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(2048)"/>
            <column name="create_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="TIMESTAMP"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_job_run_log_name" tableName="job_run_log">
            <column name="job_name"/>
        </createIndex>
        <createIndex indexName="idx_job_run_log_start" tableName="job_run_log">
            <column name="start_time"/>
        </createIndex>
    </changeSet>

    <changeSet id="v1.0.0-demo-order" author="scaffold">
        <createTable tableName="demo_order">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_demo_order"/>
            </column>
            <column name="order_no" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="external_user_no" type="VARCHAR(128)"/>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="TIMESTAMP"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_demo_order_no" tableName="demo_order" unique="true">
            <column name="order_no"/>
        </createIndex>
        <createIndex indexName="idx_demo_order_owner" tableName="demo_order">
            <column name="owner_account_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
