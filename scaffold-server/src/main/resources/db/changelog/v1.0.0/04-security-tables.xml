<?xml version="1.0" encoding="UTF-8"?>
<!-- 安全审计表：登录日志 + 操作日志 -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="v1.0.0-login-log" author="scaffold">
        <createTable tableName="sys_login_log">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_sys_login_log"/>
            </column>
            <column name="account_no" type="VARCHAR(64)"/>
            <column name="login_type" type="VARCHAR(32)"/>
            <column name="success" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="fail_reason" type="VARCHAR(128)"/>
            <column name="ip" type="VARCHAR(64)"/>
            <column name="user_agent" type="VARCHAR(255)"/>
            <column name="login_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_login_log_account" tableName="sys_login_log">
            <column name="account_no"/>
        </createIndex>
        <createIndex indexName="idx_login_log_time" tableName="sys_login_log">
            <column name="login_time"/>
        </createIndex>
    </changeSet>

    <changeSet id="v1.0.0-oper-log" author="scaffold">
        <createTable tableName="sys_oper_log">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_sys_oper_log"/>
            </column>
            <column name="module" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="operator" type="VARCHAR(64)"/>
            <column name="ip" type="VARCHAR(64)"/>
            <column name="uri" type="VARCHAR(255)"/>
            <column name="params" type="VARCHAR(2048)"/>
            <column name="cost_millis" type="BIGINT"/>
            <column name="success" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(1024)"/>
            <column name="create_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="TIMESTAMP"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_oper_log_module" tableName="sys_oper_log">
            <column name="module"/>
        </createIndex>
        <createIndex indexName="idx_oper_log_operator" tableName="sys_oper_log">
            <column name="operator"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
