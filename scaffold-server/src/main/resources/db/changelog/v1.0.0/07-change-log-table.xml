<?xml version="1.0" encoding="UTF-8"?>
<!-- 数据变更留痕表：@DataChange 实体的字段级新旧值 diff -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="v1.0.0-change-log-table" author="scaffold">
        <createTable tableName="sys_change_log">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_sys_change_log"/>
            </column>
            <column name="business_name" type="VARCHAR(64)"/>
            <column name="table_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="record_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="operate_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="changes" type="TEXT"/>
            <column name="operator" type="VARCHAR(64)"/>
            <column name="trace_id" type="VARCHAR(32)"/>
            <column name="occurred_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="TIMESTAMP"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_change_log_table_record" tableName="sys_change_log">
            <column name="table_name"/>
            <column name="record_id"/>
        </createIndex>
        <createIndex indexName="idx_change_log_operator" tableName="sys_change_log">
            <column name="operator"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
