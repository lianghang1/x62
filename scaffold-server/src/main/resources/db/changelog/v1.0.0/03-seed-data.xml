<?xml version="1.0" encoding="UTF-8"?>
<!-- 种子数据：默认超级管理员（仅用于开箱联调；生产环境必须在交付前修改密码或删除本 changeset 数据） -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- admin / admin123 的 BCrypt 哈希；交付前必须改密 -->
    <changeSet id="v1.0.0-seed-admin" author="scaffold">
        <insert tableName="sys_account">
            <column name="id" valueNumeric="1"/>
            <column name="account_no" value="admin"/>
            <column name="type" value="OPERATOR"/>
            <column name="status" value="ENABLE"/>
            <column name="password" value="$2b$10$iUkZGE6OeRJtfYTh9rcxXuA53sp6o0zpfSiezeCZq7fLChAKy/f42"/>
            <column name="create_time" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="deleted" valueBoolean="false"/>
        </insert>
        <insert tableName="sys_role">
            <column name="id" valueNumeric="1"/>
            <column name="role_code" value="SUPER_ADMIN"/>
            <column name="role_name" value="超级管理员"/>
            <column name="permissions" value="*"/>
            <column name="create_time" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="deleted" valueBoolean="false"/>
        </insert>
        <insert tableName="sys_account_role">
            <column name="id" valueNumeric="1"/>
            <column name="account_id" valueNumeric="1"/>
            <column name="role_id" valueNumeric="1"/>
        </insert>
        <rollback>
            <delete tableName="sys_account_role">
                <where>account_id = 1</where>
            </delete>
            <delete tableName="sys_role">
                <where>id = 1</where>
            </delete>
            <delete tableName="sys_account">
                <where>id = 1</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
