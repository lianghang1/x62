<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.scaffold</groupId>
        <artifactId>scaffold-starters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>scaffold-starter-ws</artifactId>
    <packaging>jar</packaging>
    <name>scaffold-starter-ws</name>
    <description>WebSocket 双向通道：握手复用 token 会话、会话注册表、PushChannel 接入推送体系；默认关闭</description>

    <dependencies>
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-core</artifactId>
        </dependency>
        <!-- PushService / PushChannel / 多实例转发复用 -->
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-starter-push</artifactId>
        </dependency>
        <!-- 握手鉴权复用 token 会话 -->
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
