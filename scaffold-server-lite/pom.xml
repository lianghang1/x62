<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.scaffold</groupId>
        <artifactId>scaffold</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>scaffold-server-lite</artifactId>
    <packaging>jar</packaging>
    <name>scaffold-server-lite</name>
    <description>轻量发行版：单机零依赖运行（无数据库、无 Redis），本地跑任务与轻量接口</description>

    <!-- 装配原则：只引核心三件（web + job），无 MySQL/H2、无 Redis、无安全/缓存/推送。
         这是脚手架「按需裁剪」的示范装配，能力矩阵见 README「受支持装配」。 -->

    <dependencies>
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-starter-job</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>scaffold-server-lite</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
