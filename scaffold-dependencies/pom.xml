<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sfi.scaffold</groupId>
    <artifactId>scaffold-dependencies</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>scaffold-dependencies</name>
    <description>BOM：全部依赖版本的唯一出口（三方 + 自产模块；独立 POM，禁止挂父级，避免循环导入）。外部项目经 scaffold-parent 导入本 BOM。</description>

    <properties>
        <!-- 独立 POM 无 parent：编译基线属性需自带，否则 IDEA 模块 language level 回退默认 5 -->
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>2.7.18</spring-boot.version>
        <nexus.releases>http://NEXUS_HOST/repository/maven-releases/</nexus.releases>
        <nexus.snapshots>http://NEXUS_HOST/repository/maven-snapshots/</nexus.snapshots>
        <knife4j.version>4.4.0</knife4j.version>
        <ttl.version>2.14.5</ttl.version>
        <bcprov.version>1.78.1</bcprov.version>
        <powerjob.version>4.3.9</powerjob.version>
        <hutool.version>5.8.36</hutool.version>
        <commons-lang3.version>3.12.0</commons-lang3.version>
        <guava.version>32.1.3-jre</guava.version>
        <archunit.version>0.23.1</archunit.version>
        <okhttp.version>4.12.0</okhttp.version>
        <easyexcel.version>3.3.4</easyexcel.version>
        <xfilestorage.version>2.3.0</xfilestorage.version>
        <bean-searcher.version>4.8.12</bean-searcher.version>
        <ip2region.version>2.7.0</ip2region.version>
        <logstash-logback.version>6.6</logstash-logback.version>
        <!-- 共享注解库钉版：guava/caffeine 等各自携带不同版本，dependencyConvergence 要求收敛（Enforcer 强制） -->
        <checker-qual.version>3.37.0</checker-qual.version>
        <error-prone.version>2.21.1</error-prone.version>
        <annotation-api.version>1.3.2</annotation-api.version>
        <scala-library.version>2.13.3</scala-library.version>
    </properties>

    <!-- 发布目标：BOM 独立无 parent，继承不到 scaffold-parent，需自带（与 parent 保持同步） -->
    <distributionManagement>
        <repository>
            <id>sfi-releases</id>
            <url>${nexus.releases}</url>
        </repository>
        <snapshotRepository>
            <id>sfi-snapshots</id>
            <url>${nexus.snapshots}</url>
        </snapshotRepository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>
            <!-- 自产模块版本（与 BOM 同版发布，外部项目禁止自行写版本号） -->
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-ip</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-data-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-protection</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-job</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-message</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-crypto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-powerjob</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-push</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-ws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sfi.scaffold</groupId>
                <artifactId>scaffold-starter-observability</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Boot 官方 BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 接口文档 -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- 上下文传递（批次③启用，版本先行锁定） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>${ttl.version}</version>
            </dependency>

            <!-- BouncyCastle：SM3/SM4 国密（starter-crypto） -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk15to18</artifactId>
                <version>${bcprov.version}</version>
            </dependency>

            <!-- PowerJob worker（starter-powerjob；4.x 最后版本，JDK8 兼容） -->
            <dependency>
                <groupId>tech.powerjob</groupId>
                <artifactId>powerjob-worker-spring-boot-starter</artifactId>
                <version>${powerjob.version}</version>
            </dependency>

            <!-- Hutool：按需引用单个模块（规约：禁止 hutool-all 全量传递），当前仅 starter-security 的验证码使用 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-captcha</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Commons Lang3：字符串/数字/数组原子操作底座（null 安全全套），JDK8 兼容 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>

            <!-- Guava：集合运算/不可变集合/CaseFormat/Splitter 底座；32.1.3-jre 为 JDK8 兼容最终线，BOM 锁死防传递漂移 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <!-- 共享注解库钉版（版本收敛见 properties 注释） -->
            <dependency>
                <groupId>org.checkerframework</groupId>
                <artifactId>checker-qual</artifactId>
                <version>${checker-qual.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>${error-prone.version}</version>
            </dependency>
            <dependency>
                <groupId>javax.annotation</groupId>
                <artifactId>javax.annotation-api</artifactId>
                <version>${annotation-api.version}</version>
            </dependency>
            <dependency>
                <groupId>org.scala-lang</groupId>
                <artifactId>scala-library</artifactId>
                <version>${scala-library.version}</version>
            </dependency>

            <!-- ArchUnit：架构规约测试（import 唯一性强制），starter-test 提供 ScaffoldArchRules -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- OkHttp：starter-http 默认传输实现（4.x 支持 JDK8） -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>mockwebserver</artifactId>
                <version>${okhttp.version}</version>
            </dependency>

            <!-- EasyExcel：starter-excel 导入导出（3.x 支持 JDK8） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>

            <!-- x-file-storage：starter-storage 文件存储聚合器（30+ 平台适配） -->
            <dependency>
                <groupId>org.dromara.x-file-storage</groupId>
                <artifactId>x-file-storage-spring</artifactId>
                <version>${xfilestorage.version}</version>
            </dependency>

            <!-- Bean Searcher：starter-search 声明式动态检索（JDK8 兼容，与 JPA 正交共存） -->
            <dependency>
                <groupId>cn.zhxu</groupId>
                <artifactId>bean-searcher-boot-starter</artifactId>
                <version>${bean-searcher.version}</version>
            </dependency>

            <!-- ip2region：离线 IP 归属地查询（xdb 数据文件随 jar 分发，纯内存查询） -->
            <dependency>
                <groupId>org.lionsoul</groupId>
                <artifactId>ip2region</artifactId>
                <version>${ip2region.version}</version>
            </dependency>

            <!-- logstash-logback-encoder：JSON 结构化日志输出（对齐 ELK 采集，需匹配 logback 1.2.x，取 6.6） -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
